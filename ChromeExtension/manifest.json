{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting sites while the Focus app is tracking, and reports blocked attempts and browsing time back to it.",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "alarms", "idle", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Focus" },
  "icons": { "128": "icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
