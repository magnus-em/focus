{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.2.0",
  "description": "Blocks distracting sites, removes YouTube recommendations during focus, darkens bright pages, and reports browsing time to Focus.",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "alarms", "idle", "webNavigation", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"], "js": ["vendor/darkreader-proxy.js"],
    "run_at": "document_start", "all_frames": true, "world": "MAIN"
  }, {
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
    "css": ["youtube.css"], "js": ["youtube.js"], "run_at": "document_start"
  }],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Focus" },
  "icons": { "128": "icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
