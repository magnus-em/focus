{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.4.1",
  "description": "Blocks distracting sites, filters YouTube recommendations to educational videos, darkens bright pages, saves pages to read later, and reports browsing time to Focus.",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "alarms", "idle", "webNavigation", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"], "js": ["vendor/darkreader-proxy.js"],
    "run_at": "document_start", "all_frames": true, "world": "MAIN"
  }, {
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
    "css": ["youtube.css"], "js": ["youtube.js"], "run_at": "document_start"
  }, {
    "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
    "js": ["youtube-main.js"], "run_at": "document_start", "world": "MAIN"
  }],
  "background": { "service_worker": "background.js" },
  "commands": {
    "save-page": { "suggested_key": { "default": "Alt+R" }, "description": "Save this page to Focus's reading list" }
  },
  "action": { "default_popup": "popup.html", "default_title": "Focus" },
  "icons": { "128": "icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
